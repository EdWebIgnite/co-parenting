{
	"name": "coparent-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter coparent dev",
		"build": "pnpm --filter coparent build",
		"preview": "pnpm --filter coparent preview",
		"lint": "prettier --check \"*.{js,json,md,yaml}\" docs supabase/tests && pnpm -r lint",
		"format": "prettier --write \"*.{js,json,md,yaml}\" docs supabase/tests && pnpm -r format",
		"check": "pnpm -r check",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter coparent test:e2e",
		"verify": "pnpm lint && pnpm check && pnpm test",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:test": "supabase test db",
		"db:migration": "supabase migration new"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"supabase": "^3.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^4.1.12"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"supabase",
			"esbuild"
		]
	}
}
